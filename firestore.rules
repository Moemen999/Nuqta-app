rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // الأرشفة: المحفظة/الفئة اللي ليها تاريخ مبتتمسحش، بتتأرشف — بتختفي من
    // قوايم الاختيار وبتفضل ظاهرة في التاريخ. الحقلين اختياريين عن قصد:
    // القواعد بتتحقق من المستند **بعد الدمج**، والمحافظ والفئات الموجودة من
    // قبل مالهاش الحقلين دول خالص — فلو خليناهم إجباريين كل محفظة قديمة كانت
    // هتبقى غير قابلة للتعديل. `archivedAt` نص ISO زي `createdAt` في كل حتة
    // تانية في التطبيق.
    function archiveFieldsValid(data) {
      return (!('archived' in data) || data.archived is bool)
        && (!('archivedAt' in data) || data.archivedAt is string);
    }

    /**
     * "شاركنا رأيك". المستخدم بيكتب بس — مبيقراش ومبيعدّلش ومبيمسحش، لا بتاعه
     * ولا بتاع غيره. القراية من الكونسول.
     *
     * `createdAt == request.time` معناها الوقت بييجي من السيرفر
     * (`serverTimestamp()`)، فمحدش يقدر يزوّر تاريخ.
     *
     * الطول بيتقاس هنا على النص بعد ما العميل يقلّمه — القواعد مفيهاش `trim`،
     * فالعميل بيقلّم و`size() > 0` بترفض الفاضي والمسافات لوحدها.
     */
    match /feedback/{feedbackId} {
      allow read, update, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['bug', 'idea', 'praise']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 32
        && request.resource.data.platform is string
        && request.resource.data.platform.size() <= 32
        && request.resource.data.deviceModel is string
        && request.resource.data.deviceModel.size() <= 64
        && request.resource.data.osVersion is string
        && request.resource.data.osVersion.size() <= 32
        && request.resource.data.buildNumber is string
        && request.resource.data.buildNumber.size() <= 16
        && request.resource.data.fullVersion is string
        && request.resource.data.fullVersion.size() <= 48;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /wallets/{walletId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.openingBalance is number
          && request.resource.data.lowAlert is number
          && archiveFieldsValid(request.resource.data);
      }

      match /categories/{categoryId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          // الأيقونة اختيارية: الفئات القديمة (وكل الافتراضية) مالهاش الحقل،
          // والقاعدة بتتحقق من المستند بعد الدمج — فلو خليناه مطلوب كان أي
          // تعديل على فئة قديمة هيترفض. والفاضي مسموح لأنه معناه "شيل الأيقونة".
          // `size()` بتعدّ وحدات UTF-16 (اتقاس) — نفس `.length` في الكلاينت.
          // 16 = أطول إيموجي معياري (~15) بهامش؛ لازم يطابق CATEGORY_ICON_MAX.
          && (!('icon' in request.resource.data)
              || (request.resource.data.icon is string
                  && request.resource.data.icon.size() <= 16))
          && archiveFieldsValid(request.resource.data);
      }

      match /transactions/{txId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.type in ['expense', 'income', 'withdraw']
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.walletId is string
          && request.resource.data.date is string
          // تحويل التسوية: بيرجّع رصيد محفظة مؤرشفة لصفر. الحقلين اختياريين
          // زي حقول الأرشفة — كل العمليات الموجودة من قبل مالهاش الحقلين دول
          && (!('isSettlement' in request.resource.data) || request.resource.data.isSettlement is bool)
          && (!('archivedWalletId' in request.resource.data) || request.resource.data.archivedWalletId is string);
      }

      match /budgets/{budgetId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.limit is number
          && request.resource.data.limit >= 0;
      }

      match /shakhbata_income/{month} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.income is number
          && request.resource.data.income >= 0;
      }

      match /debts/{debtId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.personName is string
          && request.resource.data.totalAmount is number
          && request.resource.data.totalAmount > 0
          && request.resource.data.direction in ['owed_to_me', 'i_owe']
          // قيمة القسط اختيارية: الديون اللي اتعملت قبل الميزة مالهاش الحقل
          // ده، والقاعدة بتتحقق من **المستند بعد الدمج** — فلو خليناه مطلوب
          // كان أي تعديل على دين قديم هيترفض بـpermission-denied
          && (!('installmentAmount' in request.resource.data)
              || (request.resource.data.installmentAmount is number
                  && request.resource.data.installmentAmount > 0))
          && (!('installmentCount' in request.resource.data)
              || (request.resource.data.installmentCount is int
                  && request.resource.data.installmentCount > 0));
      }

      match /subscriptions/{subId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.name is string
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
      }

      match /gamiyas/{gamiyaId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.name is string
          && request.resource.data.monthlyAmount is number;
      }
      match /shakhbata_settings/{docId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.needs is number
          && request.resource.data.wants is number
          && request.resource.data.future is number;
      }
    }
  }
}
