rules_version = '2';

// ⚠️ قواعد المحاكي المحلي بس — مش قواعد الإنتاج ومتتنشرش أبدًا.
// قواعد الأمان الحقيقية بتتدار من كونسول Firebase مباشرةً (مش موجودة في الريبو).
// الاختبارات هنا غرضها منطق الكتابة واتساق البيانات، مش الصلاحيات، والعميل في
// الاختبار مش مسجّل دخول (بنقلّد AuthContext) — فالمفتوح هنا مقصود.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
